{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://foundry.dev/schema/idea-brief.json",
  "title": "IdeaBrief",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "title", "summary"],
  "properties": {
    "kind":    { "const": "IdeaBrief" },
    "title":   { "type": "string", "minLength": 3, "maxLength": 140 },
    "summary": { "type": "string", "minLength": 10, "maxLength": 4000 },
    "targetMarket": { "type": "string", "maxLength": 1000 },
    "wedge":        { "type": "string", "maxLength": 1000 },
    "businessModelHypothesis": { "type": "string", "maxLength": 500 },
    "founderAssumptions":      { "type": "array", "items": { "type": "string", "maxLength": 400 } },
    "tags":                    { "type": "array", "items": { "type": "string", "maxLength": 32 } }
  }
}
