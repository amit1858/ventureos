{
  "name": "foundry",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "description": "Foundry — an AI-native Venture Operating System (PersonaLab · VentureLab · BuildSquad)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:arch": "node scripts/check-import-boundaries.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "ci": "pnpm lint && pnpm lint:arch && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^9.10.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
