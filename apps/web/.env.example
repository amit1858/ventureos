# VentureOS web app environment variables.
# Copy to `.env.local` and fill in real values. Do not commit `.env.local`.
#
# REAL MODE  → requires NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY,
#              SUPABASE_SERVICE_ROLE_KEY, VENTUREOS_CREDENTIAL_ENCRYPTION_KEY.
# DEMO MODE  → /demo and /demo/faceless-crm work with NO env vars at all.
# Provider keys (OpenAI / Anthropic / Gemini / Azure OpenAI) and the GitHub PAT
# are NEVER server-side env vars; users enter them through the BYOK UI and they
# are stored encrypted at rest.

# --- Supabase ----------------------------------------------------------------
# Public values: safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET: server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Credential encryption ---------------------------------------------------
# 32-byte symmetric key for AES-256-GCM at-rest encryption of provider secrets.
# Accepts hex (64 chars) or base64 (44 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VENTUREOS_CREDENTIAL_ENCRYPTION_KEY=

# Optional. Identifier of the active key for rotation. Defaults to "k1".
# VENTUREOS_CREDENTIAL_ENCRYPTION_KID=k1

# --- Alpha workspace (deployed Real Mode access) -----------------------------
# When set to `true`, the deployed app exposes a temporary shared workspace.
# Visitors click "Continue to Alpha Workspace" on /access, which sets an
# HttpOnly cookie and resolves them as the `alpha-user` identity for BYOK,
# ventures, labs and GitHub export. Demo Mode is unaffected.
#
# Recommended for hackathon Real Mode testing. Do NOT enable in environments
# where multiple unrelated users will share the same workspace identity. For
# that case, use Google sign-in (Supabase Auth) with VENTUREOS_ALLOWED_EMAILS
# instead.
VENTUREOS_ALPHA_ACCESS=false

# --- Google sign-in allowlist (Supabase Auth) --------------------------------
# Optional. Comma-separated, case-insensitive list of Google email addresses
# allowed to sign in to Real Mode. Empty / unset → any Google-authenticated
# user is allowed (NOT recommended for shared deployments).
#
# Non-allowlisted users see a polite /access-denied page; the allowlist itself
# is never sent to the browser.
#
# Example:
#   VENTUREOS_ALLOWED_EMAILS=you@example.com,tester2@gmail.com,tester3@gmail.com
#
# Supabase dashboard prerequisites for Google sign-in:
#   1. Auth → Providers → enable Google
#   2. Set Site URL = https://<your-deployment>.vercel.app
#   3. Add Redirect URL = https://<your-deployment>.vercel.app/auth/callback
#      and (for local dev) http://localhost:3000/auth/callback
#   4. In Google Cloud → OAuth client → Authorized redirect URI =
#      https://<your-project-ref>.supabase.co/auth/v1/callback
VENTUREOS_ALLOWED_EMAILS=

# --- PersonaLab / TinyTroupe bridge -----------------------------------------
# Optional. Absolute path to a Python interpreter where `tinytroupe` is
# installed. When set, PersonaLab can use the TinyTroupe subprocess engine.
# The decrypted BYOK secret is passed to the subprocess ONLY through the
# subprocess environment (OPENAI_API_KEY / AZURE_OPENAI_API_KEY). The bridge
# never writes secrets to argv, stdin, or logs.
# VENTUREOS_TINYTROUPE_PYTHON=C:/.uv/envs/personalab/Scripts/python.exe

# --- Local-dev-only auth fallback (NODE_ENV !== 'production') ----------------
# When Supabase is not configured AND the build is not a production build,
# the server honours a `vos_dev_user` JSON cookie for end-to-end testing in
# local dev / CI:
#   document.cookie = 'vos_dev_user=' + encodeURIComponent('{"id":"u1","email":"you@example.com"}')
# Hard-disabled in production builds — the deployed app never honours this
# cookie and never surfaces dev-cookie instructions in its UI.
