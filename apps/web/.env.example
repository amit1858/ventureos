# VentureOS web app environment variables.
# Copy to `.env.local` and fill in real values. Do not commit `.env.local`.
#
# REAL MODE  → requires NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY,
#              SUPABASE_SERVICE_ROLE_KEY, VENTUREOS_CREDENTIAL_ENCRYPTION_KEY.
# DEMO MODE  → /demo and /demo/faceless-crm work with NO env vars at all.
# Provider keys (OpenAI / Anthropic / Gemini / Azure OpenAI) and the GitHub PAT
# are NEVER server-side env vars; users enter them through the BYOK UI and they
# are stored encrypted at rest.

# --- Supabase ----------------------------------------------------------------
# Public values: safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET: server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Credential encryption ---------------------------------------------------
# 32-byte symmetric key for AES-256-GCM at-rest encryption of provider secrets.
# Accepts hex (64 chars) or base64 (44 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VENTUREOS_CREDENTIAL_ENCRYPTION_KEY=

# Optional. Identifier of the active key for rotation. Defaults to "k1".
# VENTUREOS_CREDENTIAL_ENCRYPTION_KID=k1

# --- PersonaLab / TinyTroupe bridge -----------------------------------------
# Optional. Absolute path to a Python interpreter where `tinytroupe` is
# installed. When set, PersonaLab can use the TinyTroupe subprocess engine.
# The decrypted BYOK secret is passed to the subprocess ONLY through the
# subprocess environment (OPENAI_API_KEY / AZURE_OPENAI_API_KEY). The bridge
# never writes secrets to argv, stdin, or logs.
# VENTUREOS_TINYTROUPE_PYTHON=C:/.uv/envs/personalab/Scripts/python.exe

# --- Dev-only auth fallback --------------------------------------------------
# When the Supabase vars above are unset, the server falls back to a cookie:
#   document.cookie = 'vos_dev_user=' + encodeURIComponent('{"id":"u1","email":"you@example.com"}')
# Never enable this fallback in production.
